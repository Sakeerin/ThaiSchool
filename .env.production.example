# Production Environment Configuration
# Copy this file to .env and fill in ALL values before deploying
#
# WARNING: Never commit the actual .env file to source control

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/school_management?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_DB="school_management"

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379"
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"

# ─────────────────────────────────────────────
# Authentication — MUST be changed from defaults!
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="CHANGE_ME_64_CHAR_RANDOM_STRING_openssl_rand_base64_48"
NEXTAUTH_URL="https://your-domain.com"

# JWT — use a strong random secret (min 32 chars)
JWT_SECRET="CHANGE_ME_64_CHAR_RANDOM_STRING_openssl_rand_base64_48"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# File Storage (MinIO / S3)
# ─────────────────────────────────────────────
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS_KEY"
S3_SECRET_KEY="CHANGE_ME_MINIO_SECRET_KEY"
S3_BUCKET="school-files"
S3_REGION="us-east-1"

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT="587"
SMTP_USER="noreply@your-school-domain.com"
SMTP_PASS="CHANGE_ME_EMAIL_PASSWORD"
SMTP_FROM="noreply@your-school-domain.com"

# ─────────────────────────────────────────────
# CORS & External URLs
# ─────────────────────────────────────────────
CORS_ORIGIN="https://your-domain.com"
NEXT_PUBLIC_API_URL="https://api.your-domain.com"

# ─────────────────────────────────────────────
# App Config
# ─────────────────────────────────────────────
NODE_ENV="production"
API_PORT="4000"
WEB_PORT="3000"

# ─────────────────────────────────────────────
# External Integrations (optional)
# ─────────────────────────────────────────────
ZOOM_API_KEY=""
ZOOM_API_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SMS_API_KEY=""
SMS_SENDER_NAME=""
